# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real Plaid secrets or the encryption key.

# Plaid developer credentials (https://dashboard.plaid.com/team-settings/keys)
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox or production (Plaid no longer has a separate "development" env)
PLAID_ENV=sandbox

# AES-256 key used to encrypt Plaid access tokens at rest, base64-encoded.
# Generate one with: openssl rand -base64 32
PLAID_TOKEN_ENCRYPTION_KEY=
